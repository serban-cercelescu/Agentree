{
  "name": "agentree",
  "displayName": "Agentree",
  "description": "See your Claude Code and Codex conversations, forks included, as trees. Fork at any turn and continue in the agent's own chat panel.",
  "version": "0.2.0",
  "publisher": "sadeeptha-b",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sadeeptha-B/Agentree.git"
  },
  "homepage": "https://github.com/Sadeeptha-B/Agentree",
  "bugs": {
    "url": "https://github.com/Sadeeptha-B/Agentree/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "keywords": [
    "claude code",
    "codex",
    "conversation tree",
    "fork",
    "branch",
    "transcript",
    "agent",
    "session",
    "copilot cli"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#12100e",
    "theme": "dark"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "agentree.open",
        "title": "Agentree: Open Conversation Trees"
      }
    ]
  },
  "scripts": {
    "build": "node ../build-vscode.mjs",
    "package": "vsce package --no-dependencies"
  }
}
