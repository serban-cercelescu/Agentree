  "codex": {
    "about": "The messages electron/providers/codex-appserver.ts sends, with sample values. test/appserver.test.ts holds them equal to what the client sends; the watch validates them against the schema Codex generates. forkResponse: what forkThread needs of the answer: the types it can use of each field it reads (reads), and the smallest answer it can work with (least), which the same test holds it to. Both cwds have fallbacks; the thread id has none.",
    "requests": {
      "initialize": {
        "clientInfo": {
          "name": "agentree",
          "version": "0.0.0"
        }
      },
      "thread/fork": {
        "threadId": "thread-1",
        "lastTurnId": "turn-1",
        "excludeTurns": true
      }
    },
    "notifications": [
      "initialized"
    ],
    "forkResponse": {
      "least": {
        "thread": {
          "id": "thread-2"
        }
      },
      "reads": {
        "thread": [
          "object"
        ],
        "thread.id": [
          "string"
        ],
        "thread.cwd": [
          "string",
          "null"
        ],
        "cwd": [
          "string",
          "null"
        ]
      }
    }
  },
